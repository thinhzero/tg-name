# Chạy python name.py để tự cài thư viện và nhập BOT_TOKEN + ADMIN_ID lần đầu.
# Hoặc sao chép thành .env rồi điền hai giá trị đó. Không commit .env đã điền.
# Tất cả giá trị mẫu cố ý để trống. Xem README.md để biết mục bắt buộc/tùy chọn.

# API riêng: điền trước, hoặc để trống để bot hỏi trong chat sau khi khởi chạy.
# Cách cài qua bot chỉ cần điền BOT_TOKEN + ADMIN_ID rồi chạy python name.py.
API_ID=
API_HASH=

# setup.py hoặc wizard trong bot tự lưu sau đăng nhập; không chia sẻ chuỗi này.
SESSION_STRING=
SESSION_NAME=

# Tùy chọn: bot riêng từ @BotFather. Nếu điền BOT_TOKEN, phải có ADMIN_ID.
BOT_TOKEN=
ADMIN_ID=

# Tùy chọn: thời tiết dùng wttr.in nếu không điền WEATHER_API.
WEATHER_API=
CITY=

# Tùy chọn: nhạc cần cả username và API key riêng tại https://www.last.fm/api/account/create
LASTFM_USERNAME=
LASTFM_API_KEY=

# Tên cố định của bạn; các mục còn lại để trống sẽ dùng mặc định trong README.
BASE_NAME=
TIMEZONE=
LANGUAGE=
NAME_FORMAT=
BIO_FORMAT=
